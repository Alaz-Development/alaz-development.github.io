{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "compatibility_date": "2024-09-23",

  "assets": {
    "directory": "./"
  },

  // /* kaldırıldı, sadece saf domain yazıldı
  "routes": [
    { "pattern": "www.alazdevelopment.com", "custom_domain": true },
    { "pattern": "alazdevelopment.com", "custom_domain": true }
  ],

  "observability": {
    "logs": {
      "enabled": true
    }
  }
}