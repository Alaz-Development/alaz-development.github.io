{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",

  // Alan adlarını kalıcı yapan kısım
  "routes": [
    { "pattern": "www.alazdevelopment.com/*", "custom_domain": true },
    { "pattern": "alazdevelopment.com/*", "custom_domain": true }
  ],

  // Cloudflare loglama ayarları
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}